MongooseURL=
JWT_SECRET_KEY=
PORT=3000

# Fast2SMS API key (SMS OTP login)
smsApi=
# Gmail address and an app password (email OTP login)
EMAIL=
EMAIL_PASSWORD=

# Optional
# Secret that lets a signup request create an admin account (send it as "adminSecret"). Leave empty to disable admin signup.
ADMIN_SIGNUP_SECRET=
# Allowed frontend origin(s), comma separated. All origins are allowed when empty.
CORS_ORIGIN=
JWT_EXPIRES_IN=1d
